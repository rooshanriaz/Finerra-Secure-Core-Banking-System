# Point the SPA at the API Gateway (recommended). Matches New_Summary.md and local dev.
VITE_API_BASE_URL=http://localhost:8080

# Production: set to your gateway public URL or leave empty if the app is served behind same-origin /api proxy.

# OIDC / Keycloak — leave VITE_OIDC_ISSUER unset for same-origin /realms/... (Vite + nginx proxy; avoids CORS).
# Use an absolute URL only if you configure Keycloak web origins / CORS for the SPA origin.
# VITE_OIDC_ISSUER=http://localhost:8090/realms/finnera
VITE_OIDC_CLIENT_ID=finnera-web
