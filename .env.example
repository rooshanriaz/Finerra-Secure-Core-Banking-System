# Unified environment template for local and production-like setups.
# Copy to ".env" and replace all CHANGE_ME_* placeholders before deployment.
# Quick start:
#   docker compose up -d --build
# UI: http://localhost:3001 | API Gateway: http://localhost:8080 | Keycloak: http://localhost:8090

# Infrastructure
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_DB_PASSWORD
MYSQL_USER=fyp_user
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# JWT / OIDC
JWT_SECRET=CHANGE_ME_64PLUS_CHAR_RANDOM_SECRET
OIDC_ISSUER_URL=https://auth.example.internal:8082
OAUTH2_ISSUER_URI=https://keycloak.example.internal/realms/finnera
OAUTH2_JWK_SET_URI=https://keycloak.example.internal/realms/finnera/protocol/openid-connect/certs
OAUTH2_AUDIENCE=api-gateway
KEYCLOAK_ADMIN=CHANGE_ME_KEYCLOAK_ADMIN
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN_PASSWORD
KEYCLOAK_FRONTEND_CLIENT_ID=finnera-web

# Hyperledger Fabric
FABRIC_ENABLED=true
FABRIC_NETWORK_CONFIG=/app/fabric-network/config/connection-bank-docker.yaml
FABRIC_WALLET_PATH=/app/fabric-wallet
FABRIC_CONFIG=/app/fabric-network/connection-profile-docker.yaml
FABRIC_WALLET=/app/fabric-wallet
FABRIC_USER=admin
FABRIC_IDENTITY=admin

# Platform TLS / mTLS
SERVER_SSL_ENABLED=true
SERVER_SSL_KEYSTORE_PATH=/app/certs/gateway-keystore.p12
SERVER_SSL_KEYSTORE_PASSWORD=CHANGE_ME_KEYSTORE_PASSWORD
SERVER_SSL_KEYSTORE_TYPE=PKCS12
SERVER_SSL_TRUSTSTORE_PATH=/app/certs/truststore.p12
SERVER_SSL_TRUSTSTORE_PASSWORD=CHANGE_ME_TRUSTSTORE_PASSWORD
SERVER_SSL_CLIENT_AUTH=need
GATEWAY_SSL_INSECURE_TRUST_MANAGER=false

# Core banking integration (Apache Fineract)
# FINERACT_BASE_URL=https://host.docker.internal:8443/fineract-provider/api
FINERACT_MTLS_ENABLED=true
FINERACT_CLIENT_KEYSTORE_PATH=/app/certs/cbc-keystore.p12
FINERACT_CLIENT_KEYSTORE_PASSWORD=CHANGE_ME_KEYSTORE_PASSWORD
FINERACT_TRUST_STORE_PATH=/app/certs/truststore.p12
FINERACT_TRUST_STORE_PASSWORD=CHANGE_ME_TRUSTSTORE_PASSWORD
FINERACT_SKIP_SSL_VERIFICATION=false

# Fraud detection service credentials (transaction-service -> fraud API)
FRAUD_SERVICE_ADMIN_USERNAME=admin
FRAUD_SERVICE_ADMIN_PASSWORD=CHANGE_ME_FRAUD_ADMIN_PASSWORD
FRAUD_SERVICE_SYSTEM_USERNAME=system
FRAUD_SERVICE_SYSTEM_PASSWORD=CHANGE_ME_FRAUD_SYSTEM_PASSWORD
